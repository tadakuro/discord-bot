# Discord application
DISCORD_TOKEN=

# Database (CockroachDB / any Postgres)
DATABASE_URL=

# Optional: Better Stack heartbeat URL (for 24/7 uptime alerts):
# create a Heartbeat in Better Stack and paste its URL here.
# Leave empty to disable.
HEARTBEAT_URL=

# AI (/ai ask) — Ollama Cloud hosted models, e.g. nemotron-3-super:cloud.
# Get a key at https://ollama.com/settings → API keys.
OLLAMA_API_KEY=
# Optional: point at a local ollama server (default: https://ollama.com).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: override the default model name.
AI_MODEL=nemotron-3-super:cloud